{
  "id": "tool-roundtrip",
  "version": "1.0.0",
  "capability": "tools",
  "description": "Server-level tool-call roundtrip: prompt must trigger a declared function and produce well-formed structured tool_calls (valid JSON args). Proves --jinja parsing.",
  "harness": ["openai-api"],
  "runner": "tests/runners/tool_roundtrip.py",
  "endpoint_var": "LLAMA_ENDPOINT",
  "acceptance": {
    "min_score": 1.0,
    "required_observations": ["tool call(s) well-formed"]
  },
  "examples": [
    "python tests/runners/tool_roundtrip.py --endpoint http://127.0.0.1:1234/v1 --model qwen3.8-27b"
  ]
}
